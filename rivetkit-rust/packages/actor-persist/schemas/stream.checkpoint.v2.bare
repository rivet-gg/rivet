type Failure struct {
    attempts: u32
    firstFailedAt: i64
    lastFailedAt: i64
    nextAttemptAt: i64
    paused: bool
    notified: bool
    error: str
}

type DeadLetter struct {
    stream: str
    producerId: str
    envelope: data
    deliveryError: optional<str>
}

type Data struct {
    offset: str
    completed: u64
    failure: optional<Failure>
    deadLetter: optional<DeadLetter>
}
